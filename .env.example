# Copy to .env and fill in. Never commit .env.

# Provider keys (only the providers referenced in config/models.yaml are needed)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# JEB selector endpoint. JEB is called through the OpenAI-compatible chat API.
# Leave JEB_BASE_URL empty to use the provider configured for the selector model
# in config/models.yaml (by default OpenRouter).
JEB_BASE_URL=
JEB_API_KEY=
JEB_MODEL=

# Telemetry
ROUTER_LOG_PATH=data/requests.jsonl
ROUTER_STORE_PROMPTS=false
