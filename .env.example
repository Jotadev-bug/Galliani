# Copy to .env and fill in. Never commit .env.

# Provider keys (only the providers referenced in config/models.yaml are needed)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Jev (TypeSafe's decision model) is called through the OpenRouter Decisions API using
# OPENROUTER_API_KEY. These optional overrides point it elsewhere, e.g. TypeSafe's own API
# or a pinned Jev version. Defaults come from config/routing.yaml and config/models.yaml.
JEV_BASE_URL=
JEV_API_KEY=
JEV_MODEL=

# Telemetry
ROUTER_LOG_PATH=data/requests.jsonl
ROUTER_STORE_PROMPTS=false
