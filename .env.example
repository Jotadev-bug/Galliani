# Copy to .env and fill in. Never commit .env.

# Provider keys (only the providers referenced in config/models.yaml are needed)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Jev selector endpoint. Jev is called through the OpenAI-compatible chat API.
# Leave JEV_BASE_URL empty to use the provider configured for the selector model
# in config/models.yaml (by default OpenRouter).
JEV_BASE_URL=
JEV_API_KEY=
JEV_MODEL=

# Telemetry
ROUTER_LOG_PATH=data/requests.jsonl
ROUTER_STORE_PROMPTS=false
